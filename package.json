{
  "name": "scoutway",
  "version": "1.0.0",
  "description": "ScoutWay — Travel Story Sharing App (MERN)",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "cd server && npm install --legacy-peer-deps && cd ../client && npm install",
    "start:server": "cd server && node index.js"
  }
}
